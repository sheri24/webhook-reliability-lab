WEBHOOK_LAB_POSTGRES_DB=webhook_lab
WEBHOOK_LAB_POSTGRES_USER=webhook_lab
WEBHOOK_LAB_POSTGRES_PASSWORD=webhook_lab_dev
WEBHOOK_LAB_POSTGRES_HOST_PORT=5432
WEBHOOK_LAB_DATABASE_URL=postgres://webhook_lab:webhook_lab_dev@127.0.0.1:5432/webhook_lab
WEBHOOK_LAB_DATABASE_CONNECTION_TIMEOUT_MS=3000
# Local lab secret only; do not reuse it for a real provider.
WEBHOOK_LAB_HMAC_SECRET=webhook-lab-local-secret-change-me
API_PORT=3000
WEBHOOK_LAB_WORKER_POLL_INTERVAL_MS=500
WEBHOOK_LAB_WORKER_LEASE_DURATION_MS=30000
# Optional label; defaults to hostname-process ID.
# WEBHOOK_LAB_WORKER_ID=worker-local-1
# Optional one-shot development failpoint, matched by provider event ID.
# Requires NODE_ENV=development and is used by a worker process only.
# WEBHOOK_LAB_CRASH_AFTER_CLAIM_EVENT_ID=
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
